rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // A user's saved stocks. Signed in AND their own document — one uid must
    // never be able to read another's list.
    match /ephedrine2010/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Everything else is closed. The dashboard is public market data fetched
    // straight from the sources and never touches Firestore, so denying here
    // breaks nothing in the app.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
